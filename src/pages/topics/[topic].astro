---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts, uniqueCategories } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
  return uniqueCategories(posts).map((topic) => ({
    params: { topic },
    props: { topic, posts: posts.filter((post) => post.data.categories.includes(topic)) }
  }));
}

const { topic, posts } = Astro.props;
---

<BaseLayout title={topic} description={`JACL Blog 中关于 ${topic} 的文章。`}>
  <section class="page-hero shell compact">
    <p class="eyebrow">TOPIC / {posts.length} NOTES</p>
    <h1>{topic}</h1>
  </section>
  <section class="shell listing-page">
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>
</BaseLayout>
