---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts, uniqueTags } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
  return uniqueTags(posts).map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) }
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`带有 ${tag} 标签的文章。`}>
  <section class="page-hero shell compact">
    <p class="eyebrow">TAG / {posts.length} NOTES</p>
    <h1><em>#</em>{tag}</h1>
  </section>
  <section class="shell listing-page">
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>
</BaseLayout>
