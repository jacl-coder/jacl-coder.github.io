---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="这个页面不存在。">
  <section class="not-found shell">
    <p class="eyebrow">ERROR / 404</p>
    <h1>这条路径，<br /><em>还没有被写下。</em></h1>
    <p>页面可能已经移动，也可能从未存在。</p>
    <a class="button primary" href="/">返回首页</a>
  </section>
</BaseLayout>
