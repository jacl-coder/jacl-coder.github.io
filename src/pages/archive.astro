---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, postPath, sortPosts } from '../lib/posts';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))];
---

<BaseLayout title="归档" description="按时间查看 JACL Blog 的全部文章。">
  <section class="page-hero shell compact">
    <p class="eyebrow">ARCHIVE / {posts.length} NOTES</p>
    <h1>时间留下的<br /><em>技术切片。</em></h1>
  </section>

  <section class="archive shell narrow">
    {years.map((year) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <ol>
          {posts.filter((post) => post.data.date.getFullYear() === year).map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <a href={postPath(post)}>{post.data.title}</a>
              <span>{post.data.categories[0] ?? '随笔'}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</BaseLayout>
